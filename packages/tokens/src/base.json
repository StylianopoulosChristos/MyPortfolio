{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "var(--font-geist-sans), system-ui, sans-serif" },
      "mono": { "$value": "var(--font-geist-mono), ui-monospace, monospace" }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": "clamp(2.5rem, 2rem + 2vw, 3.5rem)" },
      "h1": { "$value": "clamp(2rem, 1.75rem + 1vw, 2.5rem)" },
      "h2": { "$value": "1.75rem" },
      "h3": { "$value": "1.25rem" },
      "body-lg": { "$value": "1.125rem" },
      "body": { "$value": "1rem" },
      "small": { "$value": "0.875rem" },
      "label": { "$value": "0.75rem" },
      "code": { "$value": "0.8125rem" }
    },
    "line-height": {
      "display": { "$value": "1.07", "$type": "number" },
      "h1": { "$value": "1.1", "$type": "number" },
      "h2": { "$value": "2.125rem", "$type": "dimension" },
      "h3": { "$value": "1.75rem", "$type": "dimension" },
      "body-lg": { "$value": "1.75rem", "$type": "dimension" },
      "body": { "$value": "1.625rem", "$type": "dimension" },
      "small": { "$value": "1.25rem", "$type": "dimension" },
      "label": { "$value": "1rem", "$type": "dimension" },
      "code": { "$value": "1.25rem", "$type": "dimension" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.035em" },
      "h1": { "$value": "-0.03em" },
      "h2": { "$value": "-0.02em" },
      "h3": { "$value": "-0.01em" },
      "label": { "$value": "0.06em" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" },
    "10": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "1120px" },
    "gutter": { "$value": "24px" },
    "page-padding": { "$value": "16px" },
    "page-padding-wide": { "$value": "32px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px" }
  }
}
